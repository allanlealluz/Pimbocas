rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Elenco global: qualquer jogador logado pode ler; edições são permitidas
    // para contas autenticadas (as regras do seu projeto podem restringir UID).
    match /heroes/{heroId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /loadouts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Matchmaking legado (o modo sala usa PeerJS direto, sem estes documentos).
    match /matchmakingQueue/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /matches/{matchId} {
      allow read, write: if request.auth != null;
    }
  }
}
