rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Perfil: usuário só acessa o próprio documento.
    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }

    // Loadout: usuário só acessa o próprio.
    match /loadouts/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }

    // Fila de matchmaking sem Cloud Functions (MVP).
    // IMPORTANTE: em produção, mover pareamento para backend confiável.
    match /matchmakingQueue/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid);
    }

    // Salas/partidas: MVP permissivo para participantes.
    // Em produção, validar com backend/Functions ou servidor autoritativo.
    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    // Catálogo de heróis: leitura pública opcional, escrita bloqueada.
    match /heroes/{heroId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
