# Firebase Web App config (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: provedor usado pelo antigo login rápido (anonymous | google)
# A tela de login também oferece e-mail/senha, Google, convidado e modo local.
VITE_FIREBASE_AUTH_PROVIDER=anonymous
